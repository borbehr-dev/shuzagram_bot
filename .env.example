# ============================================================
# ShuzaGram OTP Bot — переменные окружения
# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env
# ============================================================

# ===== Telegram Bot =====
# Токен от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ID администраторов через запятую (без пробелов)
# У них нет лимита номеров и доступны админ-команды
ADMIN_IDS=123456789,987654321

# ===== PostgreSQL =====
# Та же БД, что использует ShuzaGram (либо отдельная — не важно)
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# ВАЖНО: драйвер asyncpg не понимает ?sslmode=disable — его надо убрать
DATABASE_URL=postgresql+asyncpg://telesrv:changeme@127.0.0.1:15432/telesrv_main

# ===== Webhook (приём OTP-кодов от ShuzaGram) =====
# Адрес и порт, на котором бот слушает POST /v1/otp/deliveries
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=9091
WEBHOOK_PATH=/v1/otp/deliveries

# Секрет для проверки подписи вебхука.
# Должен совпадать с TELESRV_OTP_WEBHOOK_SECRET в .env ShuzaGram.
# Оставь пустым для отключения проверки (порт слушает только 127.0.0.1, безопасно).
OTP_WEBHOOK_SECRET=